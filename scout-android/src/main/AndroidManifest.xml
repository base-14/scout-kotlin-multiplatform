<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Cross-process bridge authority (Model A). Runs in the main process; secondary processes
             read the shared session via ContentResolver. exported=false: same-app only. -->
        <provider
            android:name="io.base14.scout.android.internal.ScoutBridgeProvider"
            android:authorities="${applicationId}.scout.bridge"
            android:exported="false"
            android:multiprocess="false" />
    </application>

</manifest>
